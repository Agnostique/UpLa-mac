          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bu kısayolu kabul etmedi (hata %@). Başka bir kısayol seçin."
          }
        }
      }
    },
    "macOS's own ⇧⌘3, ⇧⌘4 and ⇧⌘5 keep working; UpLa's defaults add ⌥." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS's own ⇧⌘3, ⇧⌘4 and ⇧⌘5 keep working; UpLa's defaults add ⌥."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
